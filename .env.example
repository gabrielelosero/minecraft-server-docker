# --- Server ---
# PAPER (plugins, best performance), VANILLA, FABRIC or FORGE (mods)
SERVER_TYPE=PAPER
# LATEST or a specific version, e.g. 1.21.4
MC_VERSION=LATEST
# RAM for the server: 2G for a few friends, 4G-6G for 10-20 players or modpacks
MEMORY=2G
SERVER_PORT=25565
MOTD=A Minecraft Server
# peaceful, easy, normal, hard
DIFFICULTY=normal
MAX_PLAYERS=20
# Admins (comma-separated usernames)
OPS=
ENABLE_WHITELIST=false
WHITELIST=
# Modrinth plugins/mods to install, e.g. luckperms,essentialsx
MODRINTH_PROJECTS=
TZ=Europe/Rome

# --- RCON (remote console, used by backups) ---
# Use a long random password: openssl rand -hex 16
RCON_PASSWORD=

# --- Backups ---
# How often: 30m, 6h, 1d...
BACKUP_INTERVAL=6h
# Delete backups older than N days
PRUNE_BACKUPS_DAYS=7
# Skip backups while no one is online
PAUSE_IF_NO_PLAYERS=true
